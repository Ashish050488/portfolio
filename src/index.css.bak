@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap');
@import "tailwindcss";

@custom-variant dark (&:is(.dark *));

:root {
  --bg: #FAFAFA;
  --fg: #0A0A0A;
  --fg-muted: #6B6B6B;
  --border: #E5E5E5;
  --edge-rgb: 0, 0, 0;
}

.dark {
  --bg: #0C0C0C;
  --fg: #F5F5F5;
  --fg-muted: #888888;
  --border: #222222;
  --edge-rgb: 255, 255, 255;
}

* {
  box-sizing: border-box;
  cursor: none !important;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'DM Sans', sans-serif;
  background-color: var(--bg);
  color: var(--fg);
  transition: background-color 0.4s ease, color 0.4s ease;
  -webkit-font-smoothing: antialiased;
}

::selection {
  background: var(--fg);
  color: var(--bg);
}

*:focus-visible {
  outline: 1px solid var(--fg);
  outline-offset: 4px;
}

.font-serif {
  font-family: 'Cormorant Garamond', serif;
}

.font-mono {
  font-family: 'JetBrains Mono', monospace;
}

/* ── Custom cursor ── */
.custom-cursor {
  position: fixed;
  width: 12px;
  height: 12px;
  background: var(--fg);
  border-radius: 50%;
  pointer-events: none;
  z-index: 99999;
  transition: transform 0.15s ease, opacity 0.3s ease;
  transform: translate(-50%, -50%);
}
.custom-cursor.hovering {
  transform: translate(-50%, -50%) scale(3);
  opacity: 0.4;
}

/* ── Nav link underline ── */
.nav-link {
  position: relative;
}
.nav-link::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--fg);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}
.nav-link:hover::after,
.nav-link:focus-visible::after {
  transform: scaleX(1);
}

/* Active nav indicator dot */
.nav-link.active::before {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--fg);
}

/* ── Marquee ── */
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.marquee-track {
  display: flex;
  width: max-content;
  animation: marquee 30s linear infinite;
  will-change: transform;
}

.marquee-track:hover {
  animation-play-state: paused;
}

/* ── Line grow ── */
@keyframes lineGrow {
  from { transform: scaleX(0); transform-origin: left; }
  to   { transform: scaleX(1); transform-origin: left; }
}

/* ── Clip reveal ── */
@keyframes clipReveal {
  from { clip-path: inset(0 100% 0 0); }
  to   { clip-path: inset(0 0% 0 0); }
}
.clip-reveal {
  animation: clipReveal 1s cubic-bezier(0.76, 0, 0.24, 1) forwards;
}

/* ── Grain overlay ── */
.grain::after {
  content: '';
  position: fixed;
  inset: -200%;
  width: 400%;
  height: 400%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
  opacity: 0.025;
  pointer-events: none;
  z-index: 9999;
  animation: grain 0.5s steps(2) infinite;
}
@keyframes grain {
  0%, 100% { transform: translate(0, 0); }
  10% { transform: translate(-2%, -3%); }
  30% { transform: translate(3%, 2%); }
  50% { transform: translate(-1%, 4%); }
  70% { transform: translate(4%, -1%); }
  90% { transform: translate(-3%, 2%); }
}

/* ── Contact button fill effect ── */
.btn-fill {
  position: relative;
  overflow: hidden;
  z-index: 0;
}
.btn-fill::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,1);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  z-index: -1;
}
.btn-fill:hover::before {
  transform: scaleX(1);
}
.btn-fill:hover {
  color: #0A0A0A !important;
}

/* ── Blink caret ── */
@keyframes blink-caret {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  .grain::after { display: none; }
  .custom-cursor { display: none; }
  * { cursor: auto !important; }
}